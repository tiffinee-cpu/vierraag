# Allowlist, not a blocklist: ignore everything by default, then permit
# site files back in explicitly. New files stay invisible to git until
# deliberately allowed, so nothing ships by accident.
#
# NOTE: this file itself is served publicly at /.gitignore — keep the
# comments here free of anything you would not publish.
#
# Adding a new page or image? Add an explicit `!` line for it below.

*

# This file must exempt itself — `*` above matches it too.
!.gitignore

# --- Pages ---
!index.html
!privacy.html
!404.html

# --- Assets ---
!style.css
!script.js
!favicon.svg

# --- Search / crawlers ---
!robots.txt
!sitemap.xml

# --- Logos & brand marks ---
# Only marks the site actually serves are allowed through.
# logo-transparent.png is the seal used by the nav, footer and 404 page.
# logo.png is referenced by the JSON-LD LocalBusiness logo URL.
!logo.png
!logo-transparent.png

# --- Photography (images/ only, by extension) ---
!images/
!images/*.jpg
!images/*.JPG
!images/*.jpeg
!images/*.JPEG
!images/*.png
!images/*.PNG
!images/*.webp

# --- Never commit, even if allowed above ---
# .DS_Store leaks the filenames of everything else in the folder,
# including the documents this file exists to keep out.
.DS_Store
**/.DS_Store

# Local tooling / editor state
.claude/
.vscode/
.idea/
*.swp

# Secrets — belt and braces; the `*` above already covers these
.env
.env.*
*.pem
*.key
